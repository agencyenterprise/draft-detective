{
  "name": "draft-detective",
  "version": "2.4.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.22.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/agencyenterprise/draft-detective"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:webpack": "next dev --webpack",
    "dev:poll": "WATCHPACK_POLLING=true WATCHPACK_POLL_INTERVAL=1000 next dev --webpack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "cd .. && husky frontend/.husky",
    "openapi-generate": "npx @hey-api/openapi-ts"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write"
    ]
  },
