# OpenAI
OPENAI_API_KEY=
# Per-model API key overrides — JSON dict mapping model name to API key.
# Use this to assign a separate key (and thus separate rate-limit bucket) per model.
# Example: MODEL_API_KEYS={"gpt-5-mini-2025-08-07": "sk-xxx", "gpt-4.1-2025-04-14": "sk-yyy"}
# MODEL_API_KEYS={}

# Optional Azure model clients (not a replacement for workflow OpenAI/embedding keys)
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_VERSION=

# API eval routing; an existing server is the default.
# EVAL_API_BASE_URL=http://localhost:8000
# EVAL_API_AUTH_TOKEN=
# Local abbreviation-agent model override (set automatically by backend=local)
# EVAL_WORKFLOW_MODEL=openai/gpt-5.6-terra

# Logging Configuration
LOG_RICH_HANDLER=true

# Langfuse
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_TRACING_ENVIRONMENT=local
LANGFUSE_PROJECT_ID=

# Langgraph Configuration
# LANGGRAPH_MAX_CONCURRENCY=30  # Maximum concurrent langgraph nodes (default: 30)

# Database Configuration
DATABASE_URL=postgresql://ai_reviewer_user:ai_reviewer_password@0.0.0.0:5432/ai_reviewer
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_reviewer
POSTGRES_USER=ai_reviewer_user
POSTGRES_PASSWORD=ai_reviewer_password

# Concurrency config
MAX_CONCURRENT_TASKS=20

# File upload
FILE_UPLOADS_MOUNT_PATH=uploads

AUTH_SECRET=

# MCP Authentication (OAuth provider for MCP clients)
# Set false for HTTP-only local development; local eval subprocesses do this automatically.
# MCP_ENABLED=true
# At least one provider must be configured. Google is used when both are set.
# Google OAuth
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Microsoft Entra ID
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=
# Public URL of the MCP server (must include /mcp path)
MCP_BASE_URL=http://localhost:8000/mcp
# Enable CIMD for MCP OAuth providers (default: false)
# Disable if clients are behind VPNs that cannot reach the CIMD endpoint
# MCP_CIMD_ENABLED=false

# Shareable links
FRONTEND_URL=http://localhost:3000

# Rate limiter (shared across workers via Postgres)
# RATE_LIMITER_REQUESTS_PER_SECOND=2     # Average LLM rps cap (default: 2)
# RATE_LIMITER_MAX_BUCKET_SIZE=1         # Max burst size, must be >= 1 (default: 1)
# RATE_LIMITER_CHECK_EVERY_N_SECONDS=0.25 # Poll interval while blocking (default: 0.25)

# Jina Reader (used by the reference downloader to turn web pages into markdown)
# Optional. Anonymous requests are rate-limited per source IP (20/min) and may be
# challenged by Cloudflare from datacenter addresses; a key lifts the limit to
# 500/min and is tracked per key. Get one at https://jina.ai/api-dashboard
# JINA_API_KEY=
